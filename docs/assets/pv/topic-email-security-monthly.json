[{"title": "Post-training supply chain attacks hijack AI coding agents via poisoned datasets and checkpoints", "url": "news/email-security/2026-11-12/#post-training-supply-chain-attacks-hijack-ai-coding-agents-via-poisoned-datasets-and-checkpoints", "importance": 7.5, "date": "2026-11-12", "summary": "Microsoft Security Research demonstrated how poisoned training data and compromised model checkpoints enable remote code execution in AI coding agents. Dataset poisoning achieved approximately 78% attack success rate, while model poisoning builds persistent backdoors triggered by routine user reques", "takeaways": ["Dataset poisoning achieved ~78% success rate on test harnesses", "Hidden behavior activated by routine paraphrased user requests", "Backdoors enable remote code execution, file modification, tool invocation", "Study emphasizes need for independent observability beyond model evaluation"], "sources": [{"label": "Microsoft Security Blog", "url": "https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/", "origin": "research"}], "subfeeds": [{"key": "email-security", "title": "Email Security"}], "feeds": [{"key": "technology", "title": "Technology"}], "researched": true, "receivedAt": "2026-11-12T21:56:50.900730+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "Threat actors weaponize GSocket for stealthy Linux command-and-control persistence", "url": "news/email-security/2026-11-11/#threat-actors-weaponize-gsocket-for-stealthy-linux-command-and-control-persistence", "importance": 7.5, "date": "2026-11-11", "summary": "Microsoft Security detected multiple incidents where threat actors deployed GSocket, an open-source remote access tool, on compromised Linux servers to maintain persistent access after patching. GSocket relays traffic through shared public networks, eliminating need for attacker-controlled infrastru", "takeaways": ["GSocket
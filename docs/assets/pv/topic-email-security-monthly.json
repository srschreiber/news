[{"title": "Microsoft Warns of Phishing Attacks Exploiting Recent Outage", "url": "news/email-security/2026-11-14/#microsoft-warns-of-phishing-attacks-exploiting-recent-outage", "importance": 7.5, "date": "2026-11-14", "summary": "Microsoft warned of an active phishing campaign exploiting a November 12 Exchange Online outage. Attackers impersonated service health notifications, falsely claiming messages would be deleted within 24 hours, and used legitimate incident reference numbers to appear authentic. The emails contained t", "takeaways": ["Campaign originated from three sender domains: moments-notice.com, planetmaison.com, newbooker.com", "Referenced legitimate incident EX1550543 to appear authentic", "Redirected users to reallifeaccounting.com/themelist0.html via SendGrid tracking links", "Microsoft confirmed credential phishing but no confirmed credential theft or malware delivery yet", "Use Microsoft Defender for Office 365 Threat Explorer to identify suspicious emails"], "sources": [{"label": "TVC News", "url": "https://news.google.com/rss/articles/CBMipwFBVV95cUxQbkdjSnVyOFYzN3FxZ2dyZTl6dzR4bnR0bGtrZGhBUVFzbmVqUm01bVRYYjBidkRlbzB3Y0k3ZFlyR0VKN3lOQV9GT1FSclZ3Yy13a1UxeHVSWk9tSTRVNU0xRUctZXVHQzBNT19sSGdtZFl3c1JTdW1SM2hPWUVoUXBkcEtjMDdYTUZYa0YxX2lfZC1IdDMwdGwtbWM2M0dKNlpMTmQtUQ?oc=5", "origin": "research"}, {"label": "India Today", "url": "https://news.google.com/rss/articles/CBMi-_?oc=5", "origin": "rss"}], "subfeeds": [{"key": "email-security", "title": "Email Security"}], "feeds": [{"key": "technology", "title": "Technology"}], "researched": true, "receivedAt": "2026-11-14T12:36:58.508480+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "Post-training supply chain attacks hijack AI coding agents via poisoned datasets and checkpoints", "url": "news/email-security/2026-11-12/#post-training-supply-chain-attacks-hijack-ai-coding-agents-via-poisoned-datasets-and-checkpoints", "importance": 7.5, "date": "2026-11-12", "summary": "Microsoft Security Research demonstrated how poisoned training data and compromised model checkpoints enable remote code execution in AI coding agents. Dataset poisoning achieved approximately 78% attack success rate, while model poisoning builds persistent backdoors triggered by routine user reques", "takeaways": ["Dataset poisoning achieved ~78% success rate on test harnesses", "Hidden behavior activated by routine paraphrased user requests", "Backdoors enable remote code execution, file modification, tool invocation", "Study emphasizes need for independent observability beyond model evaluation"], "sources": [{"label": "Microsoft Security Blog", "url": "https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/", "origin": "research"}], "subfeeds": [{"key": "email-security", "title": "Email Security"}], "feeds": [{"key": "technology", "title": "Technology"}], "researched": true, "receivedAt": "2026-11-12T21:56:50.900730+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "Threat actors weaponize GSocket for stealthy Linux command-and-control persistence", "url": "news/email-security/2026-11-11/#threat-actors-weaponize-gsocket-for-stealthy-linux-command-and-control-persistence", "importance": 7.5, "date": "2026-11-11", "summary": "Microsoft Security detected multiple incidents where threat actors deployed GSocket, an open-source remote access tool, on compromised Linux servers to maintain persistent access after patching. GSocket relays traffic through shared public networks, eliminating need for attacker-controlled infrastru", "takeaways": ["GSocket: open-source remote access tool deployed as C2 persistence mechanism", "Relays traffic through shared public network; no attacker IP/domain to block", "Activity concentrated on web applications and hosting environments", "Avoids traditional detection methods (SSH keys, reverse shells, custom implants)", "Activity increased over recent months"], "sources": [{"label": "Microsoft Security Blog", "url": "https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/", "origin": "research"}], "subfeeds": [{"key": "email-security", "title": "Email Security"}], "feeds": [{"key": "technology", "title": "Technology"}], "researched": true, "receivedAt": "2026-11-11T20:58:43.426875+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "Linux kernel vulnerabilities uncovered through AI-assisted research yield 59 bug reports", "url": "news/email-security/2026-11-11/#linux-kernel-vulnerabilities-uncovered-through-ai-assisted-research-yield-59-bug-reports", "importance": 7.5, "date": "2026-11-11", "summary": "Microsoft's FORGE Lab used AI-assisted tool MDASH to scan Linux kernel subsystems in three months (late May to mid-June 2026), producing 59 public bug reports, 33 CVE assignments, and 38 merged fixes. Eight CVEs had confirmed root privilege-escalation exploits.", "takeaways": ["Three-month effort: 59 bug reports, 33 CVEs assigned, 38 kernel fixes merged", "26,502 raw findings generated in 2 weeks; reduced to 11,769 candidates after filtering", "8 of 33 CVEs had confirmed root privilege-escalation exploits", "621 proof-of-concept cases tested in QEMU; expert review completed", "Scanned subsystems: networking, filesystems, security modules"], "sources": [{"label": "Microsoft Security Blog", "url": "https://www.microsoft.com/en-us/security/blog/2026/11/11/lessons-from-59-linux-kernel-bug-reports/", "origin": "research"}], "subfeeds": [{"key": "email-security", "title": "Email Security"}], "feeds": [{"key": "technology", "title": "Technology"}], "researched": true, "receivedAt": "2026-11-11T20:58:43.426875+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "SCKit malware abuses ScreenConnect remote access software", "url": "
aily.com/releases/2026/11/261118065518.htm", "origin": "rss"}, {"label": "ScienceDaily — Fitness", "url": "https://www.sciencedaily.com/releases/2026/11/261118065518.htm", "origin": "rss"}, {"label": "ScienceDaily — Nutrition", "url": "https://www.sciencedaily.com/releases/2026/11/261118065518.htm", "origin": "rss"}], "subfeeds": [{"key": "diet-exercise", "title": "Diet & Exercise"}, {"key": "health", "title": "Health"}], "feeds": [{"key": "science", "title": "Science"}], "researched": true, "receivedAt": "2026-11-19T14:47:54.281960+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "GLP-1 drugs like Ozempic and Mounjaro show potential neuroprotective effects on the brain", "url": "news/diet-exercise/2026-11-17/#glp-1-drugs-like-ozempic-and-mounjaro-show-potential-neuroprotective-effects-on-the-brain", "importance": 7, "date": "2026-11-17", "summary": "Researchers from the University of Gothenburg and University of Copenhagen reviewed existing scientific evidence on GLP-1 medications (semaglutide and tirzepatide), marketed as Ozempic and Mounjaro, and their potential effects on brain health. Animal studies suggest GLP-1 drugs can influence learnin", "takeaways": [], "sources": [{"label": "ScienceDaily / University of Gothenburg", "url": "https://www.sciencedaily.com/releases/2026/11/261116023401.htm", "origin": "research"}, {"label": "ScienceDaily — Health", "url": "https://www.sciencedaily.com/releases/2026/11/261116023401.htm", "origin": "rss"}, {"label": "ScienceDaily — Fitness", "url": "https://www.sciencedaily.com/releases/2026/11/261116023401.htm", "origin": "rss"}], "subfeeds": [{"key": "diet-exercise", "title": "Diet & Exercise"}, {"key": "health", "title": "Health"}], "feeds": [{"key": "science", "title": "Science"}], "researched": true, "receivedAt": "2026-11-17T15:00:01.965457+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "Yale Study Identifies Which Anti-Aging Tr
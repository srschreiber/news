[{"title": "Trump Administration Removes Habitat Protections from Endangered Species Act", "url": "news/conservation/2026-10-04/#trump-administration-removes-habitat-protections-from-endangered-species-act", "importance": 8.0, "date": "2026-10-04", "summary": "The president of the United States finalized a rule on July 10, 2026, eliminating the regulatory definition of \"harm\" under the Endangered Species Act, removing protections for habitat destruction. The change permits farming, drilling, mining, logging, and development to proceed in endangered specie", "takeaways": ["Rule effective September 14, 2026; removes 'significant habitat modification or degradation' from the regulatory definition of harm under the Endangered Species Act", "Reverses decades of interpretation dating to the 1995 Supreme Court case Babbitt v. Sweet Home, which protected old-growth forests for spotted owls", "Habitat loss is identified as the primary driver of extinction; removal of habitat protections leaves species like manatees, ocelots, and Atlantic salmon at greater extinction risk", "Private projects without federal funding or permits now face no federal consultation requirements; much critical habitat lies outside designated areas"], "sources": [{"label": "Mongabay", "url": "https://news.google.?oc=5", "origin": "research"}, {"label": "Center for Biological Diversity", "url": "https://news.google.?oc=5", "origin": "research"}], "subfeeds": [{"key": "conservation", "title": "Conservation"}], "feeds": [{"key": "environment", "title": "Environment"}, {"key": "science", "title": "Science"}], "researched": true, "receivedAt": "2026-10-04T11:30:45.191715+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "President of the United States administration removes habitat protection from Endangered Species Act definition of harm", "url": "news/conservation/2026-10-03/#president-of-the-united-states-administration-removes-habitat-protection-from-endangered-species-act-definition-of-harm", "importance": 8.0, "date": "2026-10-03", "summary": "The president's administration finalized a rule on July 10, 2026 eliminating habitat destruction from the regulatory definition of \"harm\" under the Endangered Species Act, effective September 14. The change allows farming, drilling, mining, logging, and development to proceed in endangered species h", "takeaways": ["Rule finalizes removal of habitat degradation from \"harm\" definition under Endangered Species Act, effective September 14, 2026", "Reverses regulatory interpretation in place for over 30 years and contradicts 1995 Supreme Court precedent (Babbitt v. Sweet Home)", "Direct injury and killing of endangered species remain prohibited; habitat destruction alone no longer counts as illegal \"take\"", "Federal consultation and designated critical habitat protections remain, but much endangered species habitat lies outside designated areas and many private projects receive no federal funding or permits"], "sources": [{"label": "Mongabay", "url": "https://news.google.?oc=5", "origin": "research"}, {"label": "Center for Biological Diversity", "url": "https://news.google.?oc=5", "origin": "research"}], "subfeeds": [{"key": "conservation", "title": "Conservation"}], "feeds": [{"key": "environment", "title": "Environment"}, {"key": "science", "title": "Science"}], "researched": true, "receivedAt": "2026-10-03T10:50:04.613396+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "Aldabra giant tortoise population reaches record 180,000 in conservation success", "url": "news/conservation/2026-10-08/#aldabra-giant-tortoise-population-reaches-record-180000-in-conservation-success", "importance": 7.5, "date": "2026-10-08", "summary": "A survey by Seychelles Islands Foundation and University of Exeter found approximately 180,000 Aldabra giant tortoises on Aldabra Atoll—the highest ever recorded and a dramatic recovery from fewer than 1,000 in the 19th century. The atoll became a strict nature reserve in 1981 and UNESCO World Herit", "takeaways": ["Survey estimated ~180,000 adult and sub-adult tortoises (best estimate: ~183,000)", "Survey analyzed 2018–2022 counts; published in Ecology and Evolution", "Previous benchmark: ~100,000 from late 1990s", "Recovered from <1,000 in 19th century due to exploitation", "World's largest free-roaming giant tortoise population; atoll strict nature reserve since 1981"], "sources": [{"label": "The Guardian", "url": "https://www.theguardian.com/environment/2026/oct/08/researchers-find-180000-giant-tortoises-living-on-island-in-seychelles", "origin": "research"}, {"label": "The Guardian — Conservation", "url": "https://www.theguardian.com/environment/2026/oct/08/researchers-find-180000-giant-tortoises-living-on-island-in-seychelles", "origin": "rss"}], "subfeeds": [{"key": "conservation", "title": "Conservation"}], "feeds": [{"key": "environment", "title": "Environment"}, {"key": "science", "title": "Science"}], "researched": true, "receivedAt": "2026-10-08T19:33:00.151548+00:00", "relatedTitle": "", "relatedUrl": "", "updatesTitle": "", "updatesUrl": ""}, {"title": "Flávio Bolsonaro's electoral gains pose setback for Amazon climate protection efforts", "url": "news/climate-change/2026-10-07/#flavio-bolsonaros-electoral-gains-pose-setback-for-amazon-climate-protection-efforts", "importance": 7.5, "date": "2026-10-07", "summary": "The advancement of a figure associated with less stringent environmental policy threatens progress made under President Lula on Amazon deforestation reduction.", "takeaways": [], "sources": [{"label": "The Guardian — Climate Crisis", "url": "https://www.theguardian.com/world/2026/oct/07/flavio-bolsonaro-advance-brazil-election-jolt-climate-campaigners", "origin": "rss"}, {"label": "The Guardian — Conservation", "url": "https://www.theguardian.com/world/2026/oct/07/flavio-bolsonaro-advance-brazil-election-jolt-climate-campaigners", "origin": "r